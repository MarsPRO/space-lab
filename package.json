{
  "name": "space-lab",
  "version": "1.0.0",
  "description": "Самостоятельный движок документации и интерактивных примеров Space Lab",
  "type": "module",
  "license": "MIT",
  "author": "Mars Stepanov",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "npm": ">=10"
  },
  "bin": {
    "space-lab": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./testing": {
      "types": "./dist/runtime/scenario.d.ts",
      "import": "./dist/runtime/scenario.js"
    },
    "./renderers": {
      "types": "./dist/renderers.d.ts",
      "import": "./dist/renderers.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "dev": "node dist/cli.js dev",
    "build": "node scripts/build.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.quality.json --noEmit"
  },
  "dependencies": {
    "@babel/parser": "7.29.14",
    "@mdx-js/rollup": "3.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.10",
    "axe-core": "4.14.0",
    "fast-glob": "3.3.3",
    "i18next": "27.2.5",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "react-i18next": "18.0.3",
    "react-syntax-highlighter": "16.1.2",
    "refractor": "5.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "peerDependencies": {
    "@types/react": "^18.3.0 || ^19.0.0",
    "playwright": ">=1.50.0 <2",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript-eslint": "8.73.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
